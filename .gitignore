# ─────────────────────────────────────────────────────────────────────────────
# Conveyor — Git Ignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Maven Build Output ───────────────────────────────────────────────────────
target/
*.jar
*.war
*.class

# ── Maven Wrapper (optional — remove if you include mvnw) ───────────────────
.mvn/wrapper/maven-wrapper.jar

# ── IDE Files ────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env

# ── Uploaded Files — runtime directory, not source code ─────────────────────
uploads/

# ── OS Junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Private / Local-Only Docs ────────────────────────────────────────────────
docs/
code-doc.md
Conveyor.md

# ── Scratch / Dev Utilities (not part of the project) ────────────────────────
TestImage.java
token.json
k6/test_b64.js

# ── k6 Binary (large OS-specific binary — users install their own) ───────────
k6/k6-bin
